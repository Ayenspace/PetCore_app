{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "($uid == auth.uid && (!data.exists() || data.child('role').val() == newData.child('role').val())) || (auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin' && $uid != auth.uid)"
      }
    },
    "pets": {
      "$ownerId": {
        ".read": "auth != null",
        ".write": "$ownerId == auth.uid"
      }
    },
    "marketplace": {
      ".read": "auth != null",
      "$listingId": {
        ".write": "auth != null && ((!data.exists() && newData.child('sellerId').val() == auth.uid) || (data.exists() && data.child('sellerId').val() == auth.uid && (!newData.exists() || newData.child('sellerId').val() == data.child('sellerId').val())))"
      }
    },
    "marketplace_orders": {
      ".read": "auth != null",
      "$orderId": {
        ".write": "auth != null && ((!data.exists() && newData.child('buyerId').val() == auth.uid && root.child('marketplace').child(newData.child('listingId').val()).child('sellerId').val() == newData.child('sellerId').val()) || (data.exists() && newData.exists() && data.child('sellerId').val() == auth.uid && newData.child('buyerId').val() == data.child('buyerId').val() && newData.child('sellerId').val() == data.child('sellerId').val() && newData.child('listingId').val() == data.child('listingId').val()))",
        ".validate": "newData.hasChildren(['id', 'listingId', 'listingTitle', 'sellerId', 'buyerId', 'buyerName', 'quantity', 'status', 'createdAt']) && newData.child('quantity').val() > 0"
      }
    },
    "weight_history": {
      "$ownerId": {
        ".read": "auth != null",
        "$petId": {
          "$entryId": {
            ".write": "$ownerId == auth.uid || (root.child('users').child(auth.uid).child('role').val() == 'vet' && root.child('appointments').child($ownerId).child(newData.child('appointmentId').val()).child('vetId').val() == auth.uid && root.child('appointments').child($ownerId).child(newData.child('appointmentId').val()).child('petId').val() == $petId)",
            ".validate": "newData.hasChildren(['id', 'petId', 'weight', 'recordedAt'])"
          }
        }
      }
    },
    "appointments": {
      "$ownerId": {
        ".read": "$ownerId == auth.uid",
        "$appointmentId": {
          ".write": "$ownerId == auth.uid || data.child('vetId').val() == auth.uid"
        }
      }
    },
    "vet_appointments": {
      "$vetId": {
        ".read": "auth != null",
        "$appointmentId": {
          ".write": "auth != null && (newData.child('ownerId').val() == auth.uid || data.child('ownerId').val() == auth.uid || $vetId == auth.uid)",
          ".validate": "newData.hasChildren(['id', 'ownerId', 'petId', 'petName', 'vetId', 'dateTime', 'status'])"
        }
      }
    },
    "reminders": {
      "$ownerId": {
        ".read": "$ownerId == auth.uid",
          ".write": "$ownerId == auth.uid"
      }
    },
    "medical_records": {
      "$ownerId": {
        ".read": "$ownerId == auth.uid",
        "$recordId": {
          ".write": "$ownerId == auth.uid || (auth != null && newData.child('appointmentId').exists() && root.child('appointments').child($ownerId).child(newData.child('appointmentId').val()).child('vetId').val() == auth.uid && root.child('appointments').child($ownerId).child(newData.child('appointmentId').val()).child('petId').val() == newData.child('petId').val())"
        }
      }
    },
    "vaccinations": {
      "$ownerId": {
        ".read": "$ownerId == auth.uid",
          ".write": "$ownerId == auth.uid"
      }
    }
  }
}
